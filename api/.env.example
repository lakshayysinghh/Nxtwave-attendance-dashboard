# Copy to api/.env for local dev. Read only when APP_ENV is not "production".
APP_ENV=development
DATABASE_URL=postgres://attendance:attendance@localhost:5433/attendance?sslmode=disable
PORT=8080
APP_BASE_URL=http://localhost:3000
# Leave empty locally (a dev-only default is used). Production needs 32+ random characters.
SESSION_SECRET=
# The Owner (prime admin). After setting it, run: go run ./cmd/server create-owner
OWNER_EMAIL=
# Local demo only: email-only sign-in. The server refuses DEV_LOGIN=true outside development.
DEV_LOGIN=false
# Optional, unused by default: Google sign-in is off unless both are set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
